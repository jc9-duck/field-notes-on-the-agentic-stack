# Copy this file to .env and fill in whichever providers you're using.
# .env is gitignored — never commit real keys.

# AWS SSO profile (used only if you're not using the Bedrock bearer token below)
AWS_PROFILE=default
AWS_REGION=us-east-1

# Amazon Bedrock API key (bearer token) — from the Bedrock console.
# Also used for routes.toml's llm_clients.bedrock (the OpenAI-compatible
# surface on bedrock-runtime) — same token, same region, no separate setup.
AWS_BEARER_TOKEN_BEDROCK=

# NVIDIA NIM / Inference Hub API key (nvapi-...) — from build.nvidia.com
NVIDIA_API_KEY=

# Only needed if testing a non-Bedrock Anthropic provider directly
ANTHROPIC_API_KEY=

# OpenAI — from platform.openai.com. Last resort in failover-proxy.mjs's
# chain (routes.toml's llm_clients.openai); everything else still works
# without this, that one rung just fails and the chain reports it.
OPENAI_API_KEY=
