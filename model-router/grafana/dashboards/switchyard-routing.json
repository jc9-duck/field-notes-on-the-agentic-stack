{
  "title": "SwitchYard Routing",
  "uid": "switchyard-routing",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Requests by selected model (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "switchyard-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "switchyard-prometheus" },
          "expr": "sum by (selected_model) (rate(switchyard_llm_calls_total[$__rate_interval]))",
          "legendFormat": "{{selected_model}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Model call latency, p95 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "switchyard-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "switchyard-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(switchyard_model_call_latency_ms_bucket[$__rate_interval])))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Classifier routing overhead, p95 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "switchyard-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "switchyard-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, algorithm) (rate(switchyard_routing_overhead_ms_bucket[$__rate_interval])))",
          "legendFormat": "{{algorithm}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Client responses by outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "switchyard-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "switchyard-prometheus" },
          "expr": "sum by (outcome) (rate(switchyard_client_responses_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    }
  ]
}
