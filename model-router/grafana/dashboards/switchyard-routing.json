{
  "title": "SwitchYard Routing",
  "uid": "switchyard-routing",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Requests by selected model (count)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "switchyard-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "switchyard-prometheus" },
          "expr": "sum by (selected_model) (increase(switchyard_llm_calls_total[$__rate_interval]))",
          "legendFormat": "{{selected_model}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Model call latency, avg (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "switchyard-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "switchyard-prometheus" },
          "expr": "switchyard_model_call_latency_ms_sum / switchyard_model_call_latency_ms_count",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Classifier routing overhead, avg (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "switchyard-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "switchyard-prometheus" },
          "expr": "switchyard_routing_overhead_ms_sum / switchyard_routing_overhead_ms_count",
          "legendFormat": "{{algorithm}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Client responses by outcome (count)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "switchyard-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "switchyard-prometheus" },
          "expr": "sum by (outcome) (increase(switchyard_client_responses_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    }
  ]
}
