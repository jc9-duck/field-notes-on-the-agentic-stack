# Copy this file to .env and fill in whichever providers you're using.
# .env is gitignored — never commit real keys.

# AWS SSO profile (used only if you're not using the Bedrock bearer token below)
AWS_PROFILE=default
AWS_REGION=us-east-1

# Amazon Bedrock API key (bearer token) — from the Bedrock console
AWS_BEARER_TOKEN_BEDROCK=

# NVIDIA NIM / Inference Hub API key (nvapi-...) — from build.nvidia.com
NVIDIA_API_KEY=

# Only needed if testing a non-Bedrock Anthropic provider directly
ANTHROPIC_API_KEY=

# GitHub token for git push/pull and the github MCP server. Get it with:
# `gh auth token` (requires `gh auth login` on the host first).
GH_TOKEN=
