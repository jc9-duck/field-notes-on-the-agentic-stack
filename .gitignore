# Working drafts / process notes — not for publication
_working/

# Secrets
pi-multi-provider/.env
model-router/.env
mcp/.env
agentgateway/.env

# Session history / runtime state — not meant to be published
pi-multi-provider/.pi/
model-router/.pi/
mcp/.pi/
agentgateway/.pi/

# switchyard-server's own runtime logs — regenerated on every container start
model-router/.switchyard.log
model-router/switchyard-routing.jsonl
model-router/.trace-server.log
model-router/.failover-proxy.log
model-router/failover.jsonl
mcp/.switchyard.log
mcp/switchyard-routing.jsonl
mcp/.trace-server.log
mcp/.failover-proxy.log
mcp/failover.jsonl
mcp/.mcp-trace-server.log
mcp/logs/
agentgateway/.switchyard.log
agentgateway/switchyard-routing.jsonl
agentgateway/.trace-server.log
agentgateway/.failover-proxy.log
agentgateway/failover.jsonl
agentgateway/.mcp-trace-server.log
agentgateway/logs/

# Nested coding projects worked on from inside a container — their own repo,
# not part of this series repo's tracking.
mcp/workspace/

# agentgateway's math-server/docs-server are built inside their own Docker
# images (npm install runs there); node_modules from installing locally to
# syntax-check them before dockerizing shouldn't get committed.
agentgateway/math-server/node_modules/
agentgateway/docs-server/node_modules/
