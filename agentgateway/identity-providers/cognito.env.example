# AWS Cognito, the identity provider wired up for #22. Run
# ./identity-providers/setup-cognito.sh first (see that script's comments —
# it provisions a real, persistent User Pool under your AWS account, so
# it's meant to be run by you, not automated) — it prints these three
# values at the end. Copy them into agentgateway/.env.
#
# These three values are the *entire* provider-specific surface in this
# whole stack (see config.yaml.template) — nothing else changes if you swap
# Cognito for a different provider later.

# https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
OIDC_ISSUER=

# The app client ID setup-cognito.sh created (no client secret — this is a
# public client, fine for a demo CLI flow).
OIDC_AUDIENCE=

# <issuer>/.well-known/jwks.json — always this exact suffix on the issuer.
OIDC_JWKS_URI=

# --- Getting a role claim into the token ---
# setup-cognito.sh wires a Pre Token Generation (V2_0) Lambda trigger that
# copies each user's `custom:role` Cognito attribute into a plain `role`
# claim on their ID token — that's the claim config.yaml.template's CEL
# policy checks (`jwt.role == "editor"`). The script also creates one test
# user (`demo-editor`, custom:role=editor) so write/delete on docs-server
# have something to actually authorize. See the script's final output for
# the exact `aws cognito-idp admin-initiate-auth` command to mint a token
# for that user — that token (the ID token, not the access token; see the
# script's note on why) is what goes in AGENTGATEWAY_TOKEN in .env.
