# Copy this file to .env and fill in whichever providers you're using.
# .env is gitignored — never commit real keys.

# --- pi's own model providers (same as pi-multi-provider/, mcp/) ---
AWS_PROFILE=default
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=

# --- backend auth for agentgateway's own live external MCP targets ---
# GitHub's hosted MCP server needs a token; agentgateway injects it as the
# `github` target's Authorization header (see config.yaml's backendAuth).
# Get one with `gh auth token` (requires `gh auth login` on the host first).
# aws-knowledge, deepwiki, and context7 need nothing -- genuinely credential-free.
GH_TOKEN=

# aws-managed-server (the credentialed AWS MCP target) reuses AWS_PROFILE/
# AWS_REGION above plus the ~/.aws mount every folder in this repo already
# has -- no separate var needed here. But it DOES need an active, unexpired
# `aws sso login --profile <profile>` session on the host, or it fails in a
# way that takes the whole gateway down with it -- see the big warning next
# to the `aws-managed` target in config.yaml before you rely on this one.

# No identity/auth vars right now -- agentgateway currently has no JWT
# requirement (deliberately deferred; see README.md). When identity comes
# back as its own step, this file picks up OIDC_ISSUER/OIDC_AUDIENCE/
# OIDC_JWKS_URI again.
