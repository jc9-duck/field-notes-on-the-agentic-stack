# Copy this file to .env and fill in whichever providers you're using.
# .env is gitignored — never commit real keys.

# --- pi's own model providers (same as pi-multi-provider/, mcp/) ---
AWS_PROFILE=default
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=

# --- Identity provider for agentgateway's JWT auth ---
# These three are the *entire* provider-specific surface (see
# config.yaml.template + identity-providers/) — filled in here for AWS
# Cognito. See identity-providers/cognito.env.example for exactly where
# each value comes from and how to run identity-providers/setup-cognito.sh.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=

# A short-lived Cognito access token (JWT) for the `pi` container to
# present to agentgateway. Mint one after running setup-cognito.sh (see
# identity-providers/cognito.env.example) and re-export before each
# `docker compose run pi` — it expires like any OAuth access token.
AGENTGATEWAY_TOKEN=
