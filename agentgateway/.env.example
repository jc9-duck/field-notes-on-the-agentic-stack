# Copy this file to .env and fill in whichever providers you're using.
# .env is gitignored — never commit real keys.

# --- pi's own model providers (same as pi-multi-provider/, mcp/) ---
AWS_PROFILE=default
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=

# No identity/auth vars right now -- agentgateway currently has no JWT
# requirement (deliberately deferred; see README.md). When identity comes
# back as its own step, this file picks up OIDC_ISSUER/OIDC_AUDIENCE/
# OIDC_JWKS_URI again.
